{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diatreme",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  // Both OFF deliberately. Each is a publicly reachable front door to a live token
  // minter, inheriting production secrets, and sitting outside whatever rules are
  // bound to the custom domain. The custom domain is the only intended door.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Secrets (set with `wrangler secret put <NAME>`; never committed):
  //   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY — the github.com App the /token
  //     endpoint mints installation tokens with. OIDC_AUDIENCE (optional).
  //
  // GitHub Enterprise (ghe.com / GHES) — OPT-IN. Set these to also accept OIDC
  // tokens from a GHE tenant and mint via a GHE-side ("duplicate") App against
  // the GHE REST API:
  //   GHE_OIDC_ISSUER                 e.g. https://token.actions.<tenant>.ghe.com
  //   GHE_API_BASE                    e.g. https://<tenant>.ghe.com/api/v3
  //   GHE_GITHUB_APP_ID
  //   GHE_GITHUB_APP_PRIVATE_KEY
  //   GHE_GITHUB_APP_INSTALLATION_ID  (optional — skips the per-repo lookup)
  //
  // KV namespace holding last-known-good JWKS snapshots, so the broker can still
  // verify tokens when an issuer's JWKS endpoint is unreachable (see #147).
  //   wrangler kv namespace create DIATREME_JWKS_CACHE
  // Bound from the DIATREME_JWKS_CACHE_ID Actions variable at deploy time.
  // Without it the broker simply has no fallback; nothing else changes.
  //
  // KV namespace caching the GET /releases aggregate.
  //   wrangler kv namespace create COPILOT_QUOTA_KV
  // Binding name MUST be COPILOT_QUOTA_KV — env.COPILOT_QUOTA_KV is read.
  //
  // Not hard-coded here so self-hosters aren't shipped the maintainer's
  // namespace ID. For the hosted deploy, CI replaces the marker line below
  // with the real kv_namespaces block from the COPILOT_QUOTA_KV_ID Actions
  // variable (see .github/workflows/deploy-worker.yaml). Deploy without the
  // variable (or run locally) → no KV binding → /releases just skips its
  // cache and recomputes each request. For local dev, add the block by hand.
  // __KV_NAMESPACES__
}
