{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "release-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Production custom domain. The Cloudflare zone for magmamoose.com
  // must exist and be on Cloudflare DNS for cert provisioning to
  // work. wrangler creates the AAAA/A record and TLS automatically
  // on first deploy.
  //
  // `api.lava.magmamoose.com` is the API surface for the Lava
  // product (release-runner broker today; future Lava services may
  // share or split off). The bare `lava.magmamoose.com` is
  // intentionally NOT bound to the Worker so it stays free for a
  // marketing/portal site on whatever host (Vercel, Cloudflare Pages,
  // etc.) without conflict.
  //
  // The workers.dev URL keeps working in parallel — both hostnames
  // hit the same worker — so older consumers can migrate gradually.
  "routes": [
    {
      "pattern": "api.lava.magmamoose.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // KV namespace backing /copilot-quota (manual override + billing/metrics
  // cache + webhook signal). Add the IDs locally; not committed here so
  // the endpoint degrades gracefully when KV is absent.
  //   wrangler kv namespace create COPILOT_QUOTA_KV
  //   wrangler kv namespace create COPILOT_QUOTA_KV --preview
  // Binding name MUST be COPILOT_QUOTA_KV — env.COPILOT_QUOTA_KV is read.
  //
  // Cron trigger: every 15 minutes refresh the billing cache for owners
  // we've already seen (manual override, webhook event, or prior cache).
  // This keeps `GET /copilot-quota` fast and offloads billing-API hits
  // from the action's hot path. Skipped when COPILOT_QUOTA_KV is absent.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
