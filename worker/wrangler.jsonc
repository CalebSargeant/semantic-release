{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "release-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // KV namespace backing the /copilot-quota endpoint is added by deployers,
  // not committed here. The endpoint degrades gracefully (returns
  // rate_limited: false) when the binding is absent. To enable:
  //   wrangler kv namespace create COPILOT_QUOTA_KV
  //   wrangler kv namespace create COPILOT_QUOTA_KV --preview
  // Then add the returned ids under "kv_namespaces" in this file using the
  // binding name COPILOT_QUOTA_KV.
}
